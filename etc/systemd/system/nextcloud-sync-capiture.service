[Unit]
Description=Start nextcloud sync
After=network.target

[Service]
Type=simple
User=joachim
ExecStart=/usr/bin/nextcloudcmd -n --non-interactive --path Uploads /home/joachim/Musik https://cloud.kirche-die-bewegt.de
TimeoutStartSec=300
Slice=nextcloud-sync.slice

[Install]
WantedBy=default.target
